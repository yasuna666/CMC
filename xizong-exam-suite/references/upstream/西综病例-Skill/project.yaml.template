# ========================================
# 西综病例-Skill 项目配置模板
# ========================================
# 使用方法：
#   1. 复制本文件为 project.yaml（去掉 .template 后缀）
#   2. 修改下方路径，指向你自己的真题和教材文件
#   3. 把 project.yaml 放在你的项目根目录下
# ========================================

project_name: 临床医学考研知识库（流程版）
version: 2.0
architecture: clinical_workflow_based

# 项目描述
description: |
  以临床主诉为入口，整合诊断-治疗-并发症-监测的完整临床决策链。
  专为西医综合病例分析题设计。

# 配置
target_exam: 西医综合（临床医学考研）
textbook_version: 人民卫生出版社第10版
exam_range: 2005-2025年真题
skill_version: 西综病例-Skill v2.2

# ========================================
# 路径配置（请根据你的实际目录结构修改）
# ========================================
paths:
  root: "."                     # 项目根目录（通常不需要改）
  workflows: "临床工作流/"       # 生成的工作流文件存放目录
  textbooks: "教材/"            # 教材文件存放目录
  exams: "真题/"                # 真题文件存放目录
  skills: "Skills/"             # Skill 文件存放目录
  progress: ".progress.yaml"    # 进度追踪文件

# ========================================
# 真题文件定位规则（请根据你的实际文件修改）
# ========================================
exam_files:
  # 当年真题（已清洗的标准版，含答案解析的 md 文件）
  # 如果你的文件名不同，改成你的文件名
  current_year: "2025年真题_最终标准版.md"

  # 历年真题目录（如果你有合并好的历年真题 md 文件，放在这个目录下）
  historical_dir: "真题/"

  # 历年真题文件名格式（用于 Glob 搜索）
  historical_pattern: "*年*真题*.md"

  # 你已有的年份（列出你有的，没有的删掉）
  available_years: []
  # 示例：available_years: [2005, 2010, 2015, 2020, 2023, 2024, 2025]

# ========================================
# 教材文件定位规则（请根据你的实际文件修改）
# ========================================
# 教材文件可以是：
#   - PDF 文件（AI 用 Read 工具读取）
#   - Markdown 文件（如果你用 MinerU 等工具解析过）
#   - 文件夹（MinerU 解析后的输出目录）
#
# 按教材名称列出路径，可以有多个分册
textbook_files:
  内科学: []
  # 示例：
  # 内科学:
  #   - "教材/内科学（第10版）.pdf"
  # 或多分册：
  #   - "教材/内科学_1-300.pdf"
  #   - "教材/内科学_301-600.pdf"

  外科学: []
  病理学: []
  生理学: []
  生物化学: []
  # 根据你有的教材添加更多...

# 状态（不需要改）
created_at: ""    # 首次使用时自动填写
last_updated: ""
status: active
